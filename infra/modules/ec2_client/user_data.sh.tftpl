#!/bin/bash
set -euxo pipefail

# --- Run only once ---
# If a previous boot already completed this bootstrap, skip everything.
MARKER=/var/log/ec2-client-bootstrap.done
if [ -f "$MARKER" ]; then
  echo "Bootstrap already completed; skipping."
  exit 0
fi

# --- Install tools needed to connect to the DB and run the GitHub runner ---
# AWS CLI v2 is preinstalled on Amazon Linux 2023, so it is not in this list.
dnf install -y postgresql15 python3 python3-pip git jq tar libicu

# Make libpq tools available for all users.
echo 'export PATH=$PATH:/usr/bin' >/etc/profile.d/pgtools.sh

%{ if seed_data ~}
# --- Seed demo data on first boot ---
# Fetch DB credentials from Secrets Manager, then load the seed SQL.
SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "${secret_name}" \
  --region "${region}" \
  --query SecretString --output text)

export PGHOST=$(echo "$SECRET_JSON" | jq -r .PGHOST)
export PGPORT=$(echo "$SECRET_JSON" | jq -r .PGPORT)
export PGUSER=$(echo "$SECRET_JSON" | jq -r .PGUSER)
export PGPASSWORD=$(echo "$SECRET_JSON" | jq -r .PGPASSWORD)
export PGDATABASE=$(echo "$SECRET_JSON" | jq -r .PGADMINDB)

cat >/tmp/seed.sql <<'SQL'
${seed_sql}
SQL

# Wait for the database to accept connections, then seed it.
for i in $(seq 1 30); do
  if pg_isready -h "$PGHOST" -p "$PGPORT" -U "$PGUSER"; then
    break
  fi
  sleep 10
done

psql -v ON_ERROR_STOP=1 -f /tmp/seed.sql
%{ endif ~}

%{ if register_runner ~}
# --- Register this instance as a GitHub Actions self-hosted runner ---
RUNNER_USER=runner
RUNNER_DIR=/home/$RUNNER_USER/actions-runner

id "$RUNNER_USER" >/dev/null 2>&1 || useradd -m "$RUNNER_USER"

# Exchange the PAT for a short-lived runner registration token.
REG_TOKEN=$(curl -sS -X POST \
  -H "Authorization: Bearer ${runner_pat}" \
  -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/${github_owner}/${github_repo}/actions/runners/registration-token" \
  | jq -r .token)

# Download the runner.
mkdir -p "$RUNNER_DIR"
curl -sS -o "$RUNNER_DIR/runner.tar.gz" -L \
  "https://github.com/actions/runner/releases/download/v${runner_version}/actions-runner-linux-x64-${runner_version}.tar.gz"
tar xzf "$RUNNER_DIR/runner.tar.gz" -C "$RUNNER_DIR"
chown -R "$RUNNER_USER":"$RUNNER_USER" "$RUNNER_DIR"

# Configure and install as a service (runs as the runner user).
sudo -u "$RUNNER_USER" bash -c "cd $RUNNER_DIR && ./config.sh \
  --unattended \
  --url https://github.com/${github_owner}/${github_repo} \
  --token $REG_TOKEN \
  --name ${runner_name} \
  --labels self-hosted \
  --replace"

"$RUNNER_DIR/svc.sh" install "$RUNNER_USER"
"$RUNNER_DIR/svc.sh" start
%{ endif ~}

echo "EC2 client bootstrap complete." >"$MARKER"
