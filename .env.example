# Connection to the EXISTING RDS PostgreSQL instance.
# The runner creates/drops a per-run database on this instance.

# Host of the RDS instance (private endpoint reachable from the runner).
PGHOST=your-rds-instance.abc123.us-east-1.rds.amazonaws.com
PGPORT=5432

# Admin/maintenance user with CREATE DATABASE privileges.
PGUSER=ci_admin
PGPASSWORD=change-me

# The maintenance database used only to issue CREATE/DROP DATABASE.
# This is NOT the ephemeral test database.
PGADMINDB=postgres

# Name of the ephemeral database for this run.
# In CI this is generated per-run (see ci.yml). Locally you can hardcode one.
PGDATABASE=ci_ephemeral_local
